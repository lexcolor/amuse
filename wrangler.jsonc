// Cloudflare hosting for the web build: the static app, plus a Worker that
// proxies Google Drive streams (worker/index.js). Deploy with tool/deploy_web.ps1.
{
  "name": "amuse",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Otherwise the single-page fallback answers /drive/ with index.html.
    "run_worker_first": ["/drive/*"]
  },
  "routes": [{ "pattern": "amuse.lexdes.com", "custom_domain": true }]
}
